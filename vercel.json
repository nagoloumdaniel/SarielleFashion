{
  "buildCommand": "PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=1 DATABASE_URL=\"$DIRECT_URL\" prisma migrate deploy && next build",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/liste-attente",
      "schedule": "30 6 * * *"
    }
  ]
}
