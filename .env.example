# ============================================================
# Hairstyle by Patricia — variables d'environnement (P1.6)
# Copier vers .env.local (dev) — NE JAMAIS committer de secrets.
# .env.* est ignoré par git (sauf .env.example).
# ============================================================

# ---------- Base de données (Neon / PostgreSQL) ---------- (OBLIGATOIRE)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# À fournir dans .env.local — jamais de valeur réelle ici.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# URL dédiée aux migrations Prisma (pool plus large) : peut être identique à DATABASE_URL (optionnel)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------- Authentification (Auth.js / NextAuth) ---------- (OBLIGATOIRE)
# Générer avec: openssl rand -base64 32  (ou: npx auth secret)
AUTH_SECRET="change-me-generate-32-bytes-base64"
# URL publique de l'application (utilisée par NextAuth pour les callbacks)
NEXTAUTH_URL="http://localhost:3000"

# ---------- Compte admin initial (seed P1.6) ---------- (OPTIONNEL pour le seed)
# Si absent, aucun compte admin n'est créé lors du seed.
AUTH_ADMIN_EMAIL="zepatricia7@gmail.com"
AUTH_ADMIN_PASSWORD="change-me-strong-password"

# ---------- Application ---------- (OPTIONNEL, valeurs par défaut appliquées si absent)
# Adresse e-mail de contact affichée dans les paramètres du salon
ADMIN_EMAIL="zepatricia7@gmail.com"
# URL publique utilisée pour les liens absolus (e-mails, annulation, OG tags)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Locale d'affichage des dates/heures
NEXT_PUBLIC_APP_LOCALE="fr-FR"

# ---------- Stockage des photos (P4.4) ---------- (OBLIGATOIRE pour l'upload)
# Compatible API S3 : Cloudflare R2 en production.
# Le bucket reste privé : les photos sont lues via des URLs signées à durée limitée.
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="hairstyle-by-pati"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"

# ---------- Notifications et messagerie (P7) ----------
# Resend en production. En local, EMAIL_MODE="console" simule les envois sans
# contacter de vraie adresse et sans afficher de contenu sensible.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
EMAIL_FROM="Hairstyle by Patricia <bonjour@exemple.fr>"
# console = envoi simulé (aucun mail réel). "smtp" = Gmail SMTP (ci-dessous).
# "resend" ou vide = envoi réel via Resend.
# EMAIL_FROM doit être une adresse d'un domaine VÉRIFIÉ dans Resend pour écrire à n'importe
# quel client (onboarding@resend.dev n'envoie qu'au propriétaire du compte Resend).
EMAIL_MODE="console"
# Gmail SMTP (EMAIL_MODE="smtp") : validation en deux étapes + mot de passe d'application
# (Compte Google > Sécurité > Mots de passe des applications). Limite ~500 e-mails/jour.
SMTP_USER="adresse@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
# Secret partagé avec Vercel Cron (ou tout planificateur externe) :
# Authorization: Bearer <CRON_SECRET>. Générer avec: openssl rand -hex 32
CRON_SECRET="change-me-generate-32-bytes"

